{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stargate-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stargate-tracker",
      // Replace with the id printed by `npx wrangler d1 create stargate-tracker`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
