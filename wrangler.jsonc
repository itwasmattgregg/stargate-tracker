{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stargate-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stargate-tracker",
      "database_id": "c2073c19-ba11-4ac5-b8b3-ad9f5fb5113e",
      "migrations_dir": "migrations"
    }
  ]
}
